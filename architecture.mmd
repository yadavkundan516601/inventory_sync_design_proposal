%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Lato, Noto Sans, Helvetica, Arial, sans-serif", "fontSize": "17px", "lineColor": "#475569", "primaryTextColor": "#0f172a", "clusterBkg": "#f8fafc", "clusterBorder": "#94a3b8", "edgeLabelBackground": "#ffffff"}, "flowchart": {"curve": "basis", "nodeSpacing": 24, "rankSpacing": 44, "padding": 10, "wrappingWidth": 420}}}%%
flowchart TB
  OPS(["Ops team"])
  subgraph IN["Sales channels: orders in"]
    direction LR
    WEBo["Own website<br/>webhook"]
    NYKo["Nykaa<br/>webhook, may repeat<br/>or arrive out of order"]
    BLKo["Blinkit<br/>webhook"]
    FKo["Flipkart<br/>orders API,<br/>poll every 2 min"]
  end
  subgraph AWS[" "]
    ALB["ALB + WAF<br/>company SSO on /ops"]
    POLL["Order pollers [worker]<br/>Flipkart every 2 min,<br/>safety net every 15 min"]
    OPSAPI["Ops API + UI [api]<br/>failed syncs, retry,<br/>SKU timeline"]
    WH["Webhook receivers [api]<br/>verify HMAC,<br/>insert inbox, 200"]
    PROC["Order processor [worker]<br/>normalize, reserve,<br/>confirm"]
    NOTE["<b>AWS ap-south-1 (Mumbai)</b><br/>one VPC across 2 AZs<br/>[api] = ECS Fargate service,<br/>2-6 tasks behind the ALB<br/>[worker] = ECS Fargate service,<br/>2-4 tasks<br/>CloudWatch alarms to Slack"]
    PG[("PostgreSQL, RDS Multi-AZ<br/><b>single source of truth</b><br/>inbound_event, orders,<br/>inventory, inventory_ledger,<br/>channel_listing, erp_outbox")]
    RD[("Redis, ElastiCache<br/>rate-limit token buckets")]
    FEED["BC stock feed [worker]<br/>item ledger every 30 s"]
    ERPW["ERP sync [worker]<br/>outbox, look up<br/>before retry"]
    PUSH["Stock pushers [worker]<br/>one per channel,<br/>most urgent first"]
  end

  BC["Microsoft Business Central<br/>(ERP)<br/>down 1-2 h most Sundays"]
  OUT["<b>Sales channels: stock out</b><br/>Website: direct API, no limit<br/>Nykaa: 1 SKU/call, 5 req/s<br/>Flipkart: 50 SKUs/call, 10 req/s<br/>Blinkit: REST (2% time out) + daily CSV"]

  OPS --> ALB
  WEBo -->|"① webhooks"| ALB
  NYKo --> ALB
  BLKo --> ALB
  FKo -->|"① polled"| POLL
  ALB --> OPSAPI
  ALB --> WH
  OPSAPI <--> PG
  WH -->|"① insert"| PG
  POLL -->|"① insert"| PG
  PROC <-->|"② one transaction:<br/>order, reservation,<br/>ledger, outbox"| PG
  OPSAPI ~~~ NOTE
  PG <-->|"⑤ stock<br/>movements"| FEED
  PG <-->|"④ outbox"| ERPW
  PG -->|"③ desired vs<br/>published"| PUSH
  RD -.-|"tokens"| PUSH
  FEED <-->|"⑤ receipts, shipments,<br/>adjustments"| BC
  ERPW -->|"④ create / cancel<br/>sales order"| BC
  PUSH -->|"③ set absolute qty"| OUT

  classDef channel fill:#fdf2f8,stroke:#be185d,color:#0f172a;
  classDef compute fill:#eff6ff,stroke:#1d4ed8,color:#0f172a;
  classDef data fill:#ecfdf5,stroke:#047857,color:#0f172a;
  classDef ext fill:#fff7ed,stroke:#c2410c,color:#0f172a;
  classDef note fill:#ffffff,stroke:#cbd5e1,stroke-dasharray: 4 3,color:#334155;
  class WEBo,NYKo,BLKo,FKo,OUT channel;
  class ALB,WH,OPSAPI,POLL,PROC,PUSH,ERPW,FEED compute;
  class PG,RD data;
  class BC,OPS ext;
  class NOTE note;
